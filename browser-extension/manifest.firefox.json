{
  "manifest_version": 3,
  "name": "Fluxor Browser Companion",
  "version": "0.1.5",
  "description": "Envía descargas y medios del navegador a Fluxor.",
  "permissions": ["cookies", "contextMenus", "downloads", "storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:17846/*"],
  "background": {
    "scripts": [
      "lib/log.js",
      "lib/url.js",
      "lib/naming.js",
      "lib/store.js",
      "lib/capture.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fluxor-browser-companion@damonwork.github.io",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Enviar a Fluxor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
