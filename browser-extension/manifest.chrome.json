{
  "manifest_version": 3,
  "name": "Fluxor Browser Companion",
  "version": "0.1.4",
  "description": "Envía descargas y medios del navegador a Fluxor.",
  "key": "",
  "permissions": ["downloads", "storage", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:17846/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Enviar a Fluxor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
